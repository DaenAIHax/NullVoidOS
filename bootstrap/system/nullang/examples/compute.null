# nullang — arithmetic, comparison, and `if` as an expression (SPEC §4).
# Exercises: integer arithmetic, a pure function with a nested `if`, and
# main returning the value of a call.

fn sign(n: Int) -> Int {
  if n < 0 {
    -1
  } else {
    if n == 0 { 0 } else { 1 }
  }
}

fn main(world: World) -> Int uses !tty {
  let a = 6;
  let b = 7;
  let area = a * b;          # 42
  print(world, "computing area");
  sign(area - 42)            # sign(0) = 0  → exit 0
}
